{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "sparkmod:bolt_titan",
      "materials": {
        "default": "entity_alphatest",
        "glowing_eyes": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/bolt_titan",
        "low": "textures/entity/bolt_titan_low",
        "low1": "textures/entity/bolt_titan_low1",
        "low2": "textures/entity/bolt_titan_low2"
      },
      "geometry": {
        "default": "geometry.sparkmod.bolt_titan"
      },
      "animations": {
        "walk": "animation.sparkmod.titan.walk",
        "look": "animation.sparkmod.titan.look",
        "idle": "animation.sparkmod.titan.idle",
        "attack": "animation.sparkmod.titan.attack",
        "melee_controller": "controller.animation.sparkmod.titan.melee",
        "cast": "animation.sparkmod.titan.cast",
        "cast_controller": "controller.animation.sparkmod.titan.cast",
        "emerge": "animation.sparkmod.titan.emerge",
        "emerge_controller": "controller.animation.sparkmod.titan.emerge"
      },
      "scripts": {
        "animate": [
          {
            "walk": "query.modified_move_speed > 0.01 && !query.property('sparkmod:attacking') && !query.property('sparkmod:casting') && !query.property('sparkmod:emerging')"
          },
          {
            "idle": "query.modified_move_speed <= 0.01 && !query.property('sparkmod:attacking') && !query.property('sparkmod:casting') && !query.property('sparkmod:emerging')"
          },
          "look",
          "cast_controller",
          "melee_controller",
          "emerge_controller"
        ]
      },
      "render_controllers": [
        {
          "controller.render.sparkmod.bolt_titan": "!query.property('sparkmod:cracked')"
        },
        {
          "controller.render.sparkmod.bolt_titan_glow": "query.property('sparkmod:cracked')"
        }
      ],
      "spawn_egg": {
        "base_color": "#43240F",
        "overlay_color": "#E8BD35"
      }
    }
  }
}