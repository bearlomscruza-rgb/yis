{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sparkmod:fx_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sm_smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.size",
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.6,1.6)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)",
        "rotation_rate": "math.random(-30,30)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.6,2.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5+variable.particle_age*0.9",
          "0.5+variable.particle_age*0.9"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a*(1-variable.particle_age/variable.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}