{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sparkmod:fx_mote",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sm_star"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          "variable.size",
          "variable.size*1.6",
          "variable.size"
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.3,1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.random(-2,2)",
          0.5,
          "math.random(-2,2)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5,1.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.12,
          0.12
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a*(1-variable.particle_age/variable.particle_lifetime)"
        ]
      }
    }
  }
}