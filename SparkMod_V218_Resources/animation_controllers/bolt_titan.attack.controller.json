{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sparkmod.titan.melee": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "swing": "query.property('sparkmod:attacking')"
            }
          ]
        },
        "swing": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "ready": "!query.property('sparkmod:attacking')"
            }
          ]
        }
      }
    },
    "controller.animation.sparkmod.titan.cast": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "casting": "query.property('sparkmod:casting')"
            }
          ]
        },
        "casting": {
          "animations": [
            "cast"
          ],
          "transitions": [
            {
              "ready": "!query.property('sparkmod:casting')"
            }
          ]
        }
      }
    },
    "controller.animation.sparkmod.titan.emerge": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "emerging": "query.property('sparkmod:emerging')"
            }
          ]
        },
        "emerging": {
          "animations": [
            "emerge"
          ],
          "transitions": [
            {
              "ready": "!query.property('sparkmod:emerging')"
            }
          ]
        }
      }
    },
    "controller.animation.sparkmod.titan.shutdown": {
      "initial_state": "online",
      "states": {
        "online": {
          "transitions": [
            {
              "offline": "query.property('sparkmod:shutdown')"
            }
          ],
          "blend_transition": 0.6
        },
        "offline": {
          "animations": [
            "shutdown"
          ],
          "transitions": [
            {
              "online": "!query.property('sparkmod:shutdown')"
            }
          ],
          "blend_transition": 0.4
        }
      }
    }
  }
}