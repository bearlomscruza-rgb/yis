{
  "format_version": "1.8.0",
  "animations": {
    "animation.sparkmod.sky_beam": {
      "loop": true,
      "bones": {
        "beam": {
          "scale": [
            "query.property('sparkmod:fade')*(1+0.03*math.sin(query.life_time*400))",
            "math.min(1,query.life_time/0.4)",
            "query.property('sparkmod:fade')*(1+0.03*math.sin(query.life_time*400))"
          ]
        }
      }
    }
  }
}