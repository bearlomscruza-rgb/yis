{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.sparkmod.bolt_titan": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.low"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "sparkmod_glowing_eyes": "Material.glowing_eyes"
        }
      ],
      "textures": [
        "Array.skins[query.property('sparkmod:cracked') ? 1 : 0]"
      ]
    },
    "controller.render.sparkmod.bolt_titan_phase3": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.low",
            "Texture.god"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "sparkmod_glowing_eyes": "Material.glowing_eyes"
        }
      ],
      "textures": [
        "Array.skins[query.property('sparkmod:godmode')>0 ? 2 : (query.property('sparkmod:cracked') ? 1 : 0)]"
      ]
    }
  }
}